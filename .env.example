# ====================================================
# ARCEUS REVIEW FETCHER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your private values.
# NEVER commit your actual .env file to public GitHub!
# ====================================================

# Server Settings (Set automatically by Render / Cloud)
HOST=0.0.0.0
PORT=5000

# Telegram Bot Integration
# Generate a Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated chat IDs to receive instant review alerts
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheets Webhook URL (Optional Google Apps Script endpoint)
GOOGLE_SHEET_WEBHOOK_URL=

# Google Places API Key (Optional)
GOOGLE_PLACES_API_KEY=

# Master Admin Access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
